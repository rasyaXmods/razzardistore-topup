generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  active Boolean @default(true)
}

model Order {
  id        String   @id @default(cuid())
  orderId   String   @unique
  game      String
  sku       String
  userId    String
  zoneId    String?
  whatsapp  String
  total     Int
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
